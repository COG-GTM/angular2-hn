{
    "database": {
        "rules": "database.rules.json"
    },
    "hosting": {
        "public": "react/dist",
        "headers": [
            {
                "source": "/sw.js",
                "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
            }
        ],
        "rewrites": [
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    }
}
