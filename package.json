{
    "name": "angular-hnpwa",
    "version": "0.0.0",
    "private": true,
    "description": "Hacker News PWA (React). All application code lives in ./react; these scripts delegate to it.",
    "scripts": {
        "postinstall": "npm --prefix react ci",
        "start": "npm --prefix react run dev",
        "build": "npm --prefix react run build",
        "preview": "npm --prefix react run preview",
        "lint": "npm --prefix react run lint",
        "typecheck": "npm --prefix react run typecheck",
        "test": "npm --prefix react test",
        "test:coverage": "npm --prefix react run test:coverage",
        "e2e": "npm --prefix react run e2e"
    },
    "prettier": {
        "trailingComma": "es5",
        "tabWidth": 4,
        "singleQuote": true,
        "printWidth": 120
    }
}
