{
  "name": "angular-hnpwa",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"src-react/**/*.{ts,tsx,scss,css}\" \"*.{ts,mjs}\" tsconfig.react.json tsconfig.node.json MIGRATION.md index.html",
    "format:check": "prettier --check \"src-react/**/*.{ts,tsx,scss,css}\" \"*.{ts,mjs}\" tsconfig.react.json tsconfig.node.json MIGRATION.md index.html",
    "typecheck": "tsc -p tsconfig.react.json && tsc -p tsconfig.node.json",
    "e2e": "playwright test",
    "ng:serve": "ng serve --port 4300",
    "ng:build": "ng build",
    "ng:test": "ng test",
    "ng:lint": "ng lint",
    "ng:e2e": "ng e2e",
    "ng": "ng"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~9.0.1",
    "@angular/common": "~9.0.1",
    "@angular/compiler": "~9.0.1",
    "@angular/core": "~9.0.1",
    "@angular/forms": "~9.0.1",
    "@angular/platform-browser": "~9.0.1",
    "@angular/platform-browser-dynamic": "~9.0.1",
    "@angular/router": "~9.0.1",
    "@angular/service-worker": "~9.0.1",
    "@tanstack/react-query": "^5.104.5",
    "node-fetch": "^2.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "rxjs": "~6.5.4",
    "rxjs-compat": "^6.5.2",
    "tslib": "^1.10.0",
    "unfetch": "^4.1.0",
    "workbox-window": "^7.4.1",
    "zone.js": "~0.10.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~0.900.2",
    "@angular/cli": "~9.0.2",
    "@angular/compiler-cli": "~9.0.1",
    "@angular/language-service": "~9.0.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jasmine": "~3.3.8",
    "@types/jasminewd2": "~2.0.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "codelyzer": "^5.1.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jasmine-core": "~3.4.0",
    "jasmine-spec-reporter": "~4.2.1",
    "jsdom": "^26.1.0",
    "karma": "~4.1.0",
    "karma-chrome-launcher": "~2.2.0",
    "karma-coverage-istanbul-reporter": "~2.0.1",
    "karma-jasmine": "~2.0.1",
    "karma-jasmine-html-reporter": "^1.4.0",
    "prettier": "^3.9.10",
    "protractor": "~5.4.0",
    "sass": "^1.105.2",
    "ts-node": "~7.0.0",
    "tslint": "~5.15.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 4,
    "singleQuote": true,
    "printWidth": 120
  }
}
