{
  "name": "angular-hnpwa",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "react:typecheck": "node node_modules/typescript5/bin/tsc -p tsconfig.react.json",
    "react:harness": "sass src/react/dev/harness.scss dist/react-harness/harness.css --no-source-map && esbuild src/react/dev/main.tsx --bundle --define:process.env.NODE_ENV=\\\"development\\\" --outfile=dist/react-harness/harness.js && cp src/react/dev/index.html dist/react-harness/index.html",
    "react:serve": "npm run react:harness && python3 -m http.server 4300 --directory dist/react-harness"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~9.0.1",
    "@angular/common": "~9.0.1",
    "@angular/compiler": "~9.0.1",
    "@angular/core": "~9.0.1",
    "@angular/forms": "~9.0.1",
    "@angular/platform-browser": "~9.0.1",
    "@angular/platform-browser-dynamic": "~9.0.1",
    "@angular/router": "~9.0.1",
    "@angular/service-worker": "~9.0.1",
    "node-fetch": "^2.6.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.2",
    "rxjs": "~6.5.4",
    "rxjs-compat": "^6.5.2",
    "tslib": "^1.10.0",
    "unfetch": "^4.1.0",
    "zone.js": "~0.10.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~0.900.2",
    "@angular/cli": "~9.0.2",
    "@angular/compiler-cli": "~9.0.1",
    "@angular/language-service": "~9.0.1",
    "@types/jasmine": "~3.3.8",
    "@types/jasminewd2": "~2.0.3",
    "@types/node": "^12.11.1",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "codelyzer": "^5.1.2",
    "esbuild": "0.21.5",
    "jasmine-core": "~3.4.0",
    "jasmine-spec-reporter": "~4.2.1",
    "karma": "~4.1.0",
    "karma-chrome-launcher": "~2.2.0",
    "karma-coverage-istanbul-reporter": "~2.0.1",
    "karma-jasmine": "~2.0.1",
    "karma-jasmine-html-reporter": "^1.4.0",
    "protractor": "~5.4.0",
    "ts-node": "~7.0.0",
    "tslint": "~5.15.0",
    "typescript": "~3.7.5",
    "typescript5": "npm:typescript@5.6.3"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 4,
    "singleQuote": true,
    "printWidth": 120
  }
}
