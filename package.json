{
  "name": "angular2-hn",
  "version": "0.0.0",
  "private": true,
  "description": "Hacker News PWA. The app lives in react-app/; these scripts delegate to it.",
  "scripts": {
    "postinstall": "npm --prefix react-app ci",
    "start": "npm --prefix react-app start",
    "build": "npm --prefix react-app run build",
    "lint": "npm --prefix react-app run lint",
    "typecheck": "npm --prefix react-app run typecheck",
    "test": "npm --prefix react-app test",
    "e2e": "npm --prefix react-app run e2e"
  }
}
